AKCA_ENV=development
AKCA_DB_PATH=data/akca.db
AKCA_MIN_SELLERS_PER_ITEM=3
AKCA_PRICE_MAX_AGE_DAYS=10
AKCA_API_HOST=127.0.0.1
AKCA_API_PORT=8000
# Generate a unique private key: openssl rand -hex 32
AKCA_API_KEY=
# SEC EDGAR identifies automated clients using User-Agent. Add a real contact address before high-volume use.
AKCA_SEC_USER_AGENT=AKCA Financial Research/0.2 (contact: your-email@example.com)
# Optional: CoinGecko Demo API key (free account; recommended for stable rate limits)
COINGECKO_DEMO_API_KEY=
# Optional: FRED API key (required for macro series and real-USD CPI adjustment)
FRED_API_KEY=
# Restrict browser clients to trusted origins. Local dev defaults are added in config.
AKCA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
